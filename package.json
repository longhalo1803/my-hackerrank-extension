{
  "name": "hackerrank-native",
  "displayName": "HackerRank Native",
  "description": "Solve and submit HackerRank coding challenges directly inside Antigravity IDE and VS Code forks.",
  "version": "0.1.0",
  "publisher": "longhalo1803",
  "repository": {
    "type": "git",
    "url": "https://github.com/longhalo1803/my-hackerrank-extension"
  },
  "engines": {
    "vscode": "^1.83.0"
  },
  "categories": [
    "Programming Languages",
    "Education",
    "Other"
  ],
  "keywords": [
    "hackerrank",
    "competitive programming",
    "leetcode",
    "algorithms",
    "data structures",
    "coding challenges",
    "interview prep",
    "problem solving"
  ],
  "icon": "media/icon.png",
  "badges": [
    {
      "url": "https://img.shields.io/badge/License-MIT-green.svg",
      "href": "https://opensource.org/licenses/MIT",
      "description": "MIT License"
    }
  ],
  "bugs": {
    "url": "https://github.com/longhalo1803/My-own-hackerrank/issues"
  },
  "homepage": "https://github.com/longhalo1803/My-own-hackerrank#readme",
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hackerrank-challenges",
          "title": "HackerRank",
          "icon": "media/icon.png"
        }
      ]
    },
    "views": {
      "hackerrank-challenges": [
        {
          "id": "challengesExplorer",
          "name": "Challenges"
        }
      ]
    },
    "commands": [
      {
        "command": "hackerrank.signin",
        "title": "HackerRank: Sign In (via HackerRank Cookie)"
      },
      {
        "command": "hackerrank.checkStatus",
        "title": "HackerRank: Check Login Status"
      },
      {
        "command": "hackerrank.logout",
        "title": "HackerRank: Sign Out"
      },
      {
        "command": "hackerrank.refreshChallenges",
        "title": "HackerRank: Refresh Challenges",
        "icon": "$(refresh)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && npm run copy-assets",
    "copy-assets": "copyfiles -u 1 src/media/**/* out/ || true",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "jest --coverage"
  },
  "dependencies": {
    "katex": "^0.16.9"
  },
  "devDependencies": {
    "@types/jest": "^29.5.10",
    "@types/katex": "^0.16.7",
    "@types/node": "^18.18.0",
    "@types/vscode": "^1.83.0",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "copyfiles": "^2.4.1",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.0"
  }
}
