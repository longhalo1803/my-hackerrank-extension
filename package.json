{
  "name": "hackerrank-native",
  "displayName": "HackerRank Native",
  "description": "Solve and submit HackerRank coding challenges directly inside Antigravity IDE and VS Code forks.",
  "version": "0.1.0",
  "publisher": "longlt",
  "engines": {
    "vscode": "^1.83.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hackerrank-challenges",
          "title": "HackerRank",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "hackerrank-challenges": [
        {
          "id": "challengesExplorer",
          "name": "Challenges"
        }
      ]
    },
    "commands": [
      {
        "command": "hackerrank.signin",
        "title": "HackerRank: Sign In"
      },
      {
        "command": "hackerrank.logout",
        "title": "HackerRank: Sign Out"
      },
      {
        "command": "hackerrank.refreshChallenges",
        "title": "HackerRank: Refresh Challenges",
        "icon": "$(refresh)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && npm run copy-assets",
    "copy-assets": "copyfiles -u 1 src/media/**/* out/ || true",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "jest --coverage"
  },
  "dependencies": {
    "katex": "^0.16.9",
    "playwright-core": "^1.40.0",
    "turndown": "^7.1.2",
    "tsx": "^4.7.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.10",
    "@types/katex": "^0.16.7",
    "@types/node": "^18.18.0",
    "@types/turndown": "^5.0.4",
    "@types/vscode": "^1.83.0",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "copyfiles": "^2.4.1",
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.0"
  }
}
